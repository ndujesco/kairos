{
  "name": "kairos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "pitch:build": "python3 scripts/build-pitch.py",
    "pitch:cleva": "python3 scripts/build-pitch.py --edition cleva",
    "pitch:apwen": "python3 scripts/build-pitch.py --edition apwen",
    "pitch:shared": "python3 scripts/build-pitch.py --edition shared",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "accounts:passwords": "node --env-file=.env.local scripts/reset-account-passwords.mjs",
    "evidence:migrate": "node --env-file=.env.local scripts/migrate-evidence-to-cloudinary.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:reset:ugo": "node --env-file=.env.local scripts/reset-ugo-after-okefe.mjs",
    "demo:record": "node scripts/demo-reset.mjs --recording",
    "demo:clean": "node scripts/demo-clean.mjs",
    "snapshot:save": "node scripts/snapshot-save.mjs",
    "snapshot:restore": "node scripts/snapshot-restore.mjs",
    "snapshot:verify": "node scripts/snapshot-verify.mjs",
    "demo:prep": "node scripts/prep-ugo-cause.mjs",
    "icons": "node scripts/make-icons.mjs",
    "stage": "bash scripts/stage.sh",
    "advice": "node scripts/make-payment-advice.mjs",
    "estimate": "node scripts/make-hospital-estimate.mjs",
    "pitch:cleva-finale": "python3 scripts/build-pitch.py --edition cleva-finale",
    "pitch:cleva-preliminary": "python3 scripts/build-pitch.py --edition cleva-preliminary",
    "pitch:apwen-semi": "python3 scripts/build-pitch.py --edition apwen-semi",
    "pitch:faith-and-tech-semis": "python3 scripts/build-pitch.py --edition faith-and-tech-semis",
    "test:interview": "node scripts/verify-interview-context.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "cloudinary": "^2.11.0",
    "mongoose": "^9.7.3",
    "next": "16.2.10",
    "nodemailer": "^10.0.16",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
